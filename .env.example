# ============================================
# Trade-Wiki-AI 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- 飞书 Bot ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------- 硅基流动 API (主力) ----------
# 官网: https://siliconflow.cn
# OpenAI 兼容格式，支持 DeepSeek-V3/Qwen2.5-72B 等多种模型
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 可用模型:
#   deepseek-ai/DeepSeek-V3         (通用推理, 性价比高)
#   deepseek-ai/DeepSeek-R1         (深度推理, 思维链)
#   Qwen/Qwen2.5-72B-Instruct       (中文理解强)
#   Qwen/Qwen2.5-7B-Instruct        (轻量快速)
#   Pro/Qwen/Qwen2.5-VL-7B-Instruct (视觉理解)
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_VL_MODEL=Pro/Qwen/Qwen2.5-VL-7B-Instruct

# ---------- OpenAI API (备用，可选) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ---------- 本地模型 (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---------- 向量模型 ----------
# 硅基流动也提供向量API，可选用远程或本地
# 本地: BAAI/bge-m3 (需GPU ~1.5GB VRAM)
# 远程: BAAI/bge-m3 (通过硅基流动API调用，省本地资源)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_PROVIDER=local  # local / siliconflow

# ---------- 数据库 ----------
SQLITE_DB_PATH=./data/db/trade_wiki.db
CHROMADB_PATH=./data/chromadb

# ---------- 行情数据 ----------
# 币安 API (公开，无需API Key即可获取行情)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 美股数据 (yfinance, 无需API Key)
# AKShare (A股/港股/宏观, 无需API Key)

# ---------- 隐私与安全 ----------
ENCRYPTION_KEY=
DATA_DIR=./data

# ---------- 服务配置 ----------
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
