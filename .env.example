# ============================================
# Trade-Wiki-AI 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- 飞书 Bot ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------- 云端大模型 API ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 本地模型 ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---------- 向量模型 ----------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda

# ---------- 数据库 ----------
SQLITE_DB_PATH=./data/db/trade_wiki.db
CHROMADB_PATH=./data/chromadb

# ---------- 行情数据 ----------
# AKShare 无需 API Key，直接使用

# ---------- 隐私与安全 ----------
ENCRYPTION_KEY=
DATA_DIR=./data

# ---------- 服务配置 ----------
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO
